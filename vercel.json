{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aaryanj.tech" }],
      "destination": "https://aaryanj.tech/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
